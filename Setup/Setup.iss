; Script generated by the Inno Script Studio Wizard.
; SEE THE DOCUMENTATION FOR DETAILS ON CREATING INNO SETUP SCRIPT FILES!

#define MyAppName "HomeOrOffice"
#define MyAppVersion "1.0.1.0"
#define MyAppPublisher "LordsWare"
#define MyAppExeName "HomeOrOffice.exe"

[Setup]
; NOTE: The value of AppId uniquely identifies this application.
; Do not use the same AppId value in installers for other applications.
; (To generate a new GUID, click Tools | Generate GUID inside the IDE.)
AppId={{256F9866-2DAC-4F94-BDF0-102F3B83B83A}
AppName={#MyAppName}
AppVersion={#MyAppVersion}
;AppVerName={#MyAppName} {#MyAppVersion}
AppPublisher={#MyAppPublisher}
DefaultDirName={pf}\{#MyAppName}
DefaultGroupName={#MyAppName}
OutputDir=.\
OutputBaseFilename=HomeOrOffice_Setup
SetupIconFile=favicon.ico
Compression=lzma
SolidCompression=yes

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"
Name: "german"; MessagesFile: "compiler:Languages\German.isl"

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: unchecked

[Files]
Source: "favicon.ico"; DestDir: "{app}"; Flags: ignoreversion
Source: "..\src\HomeOrOffice\bin\Release\net10.0-windows\ClosedXML.dll"; DestDir: "{app}"; Flags: ignoreversion
Source: "..\src\HomeOrOffice\bin\Release\net10.0-windows\ClosedXML.Parser.dll"; DestDir: "{app}"; Flags: ignoreversion
Source: "..\src\HomeOrOffice\bin\Release\net10.0-windows\DocumentFormat.OpenXml.dll"; DestDir: "{app}"; Flags: ignoreversion
Source: "..\src\HomeOrOffice\bin\Release\net10.0-windows\DocumentFormat.OpenXml.Framework.dll"; DestDir: "{app}"; Flags: ignoreversion
Source: "..\src\HomeOrOffice\bin\Release\net10.0-windows\ExcelNumberFormat.dll"; DestDir: "{app}"; Flags: ignoreversion
Source: "..\src\HomeOrOffice\bin\Release\net10.0-windows\HomeOrOffice.deps.json"; DestDir: "{app}"; Flags: ignoreversion
Source: "..\src\HomeOrOffice\bin\Release\net10.0-windows\HomeOrOffice.dll"; DestDir: "{app}"; Flags: ignoreversion
Source: "..\src\HomeOrOffice\bin\Release\net10.0-windows\HomeOrOffice.exe"; DestDir: "{app}"; Flags: ignoreversion
Source: "..\src\HomeOrOffice\bin\Release\net10.0-windows\HomeOrOffice.pdb"; DestDir: "{app}"; Flags: ignoreversion
Source: "..\src\HomeOrOffice\bin\Release\net10.0-windows\RBush.dll"; DestDir: "{app}"; Flags: ignoreversion
Source: "..\src\HomeOrOffice\bin\Release\net10.0-windows\SixLabors.Fonts.dll"; DestDir: "{app}"; Flags: ignoreversion
Source: "..\src\HomeOrOffice\bin\Release\net10.0-windows\System.Data.SQLite.dll"; DestDir: "{app}"; Flags: ignoreversion
Source: "..\src\HomeOrOffice\bin\Release\net10.0-windows\EN\HomeOrOffice.resources.dll"; DestDir: "{app}\EN\"; Flags: ignoreversion
Source: "..\src\HomeOrOffice\bin\Release\net10.0-windows\runtimes\win-x86\native\SQLite.Interop.dll"; DestDir: "{app}\runtimes\win-x86\native\"; Flags: ignoreversion
Source: "..\src\HomeOrOffice\bin\Release\net10.0-windows\runtimes\win-x64\native\SQLite.Interop.dll"; DestDir: "{app}\runtimes\win-x86\native\"; Flags: ignoreversion
Source: "..\src\HomeOrOffice\bin\Release\net10.0-windows\runtimes\osx-x64\native\SQLite.Interop.dll"; DestDir: "{app}\runtimes\win-x86\native\"; Flags: ignoreversion
Source: "..\src\HomeOrOffice\bin\Release\net10.0-windows\runtimes\linux-x64\native\SQLite.Interop.dll"; DestDir: "{app}\runtimes\win-x86\native\"; Flags: ignoreversion
Source: "..\src\HomeOrOffice\bin\Release\net10.0-windows\HomeOrOffice.runtimeconfig.json"; DestDir: "{app}"; Flags: ignoreversion

[Icons]
Name: "{group}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"; IconFilename: "{app}\favicon.ico"
Name: "{commondesktop}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"; Tasks: desktopicon; IconFilename: "{app}\favicon.ico"
Name: "{commonstartup}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"; Parameters: "auto"; IconFilename: "{app}\favicon.ico"

[Run]
Filename: "{app}\{#MyAppExeName}"; Description: "{cm:LaunchProgram,{#StringChange(MyAppName, '&', '&&')}}"; Flags: nowait postinstall skipifsilent

[Dirs]
Name: "{commonappdata}\HomeOrOffice\Datenbank"; Permissions: system-full



