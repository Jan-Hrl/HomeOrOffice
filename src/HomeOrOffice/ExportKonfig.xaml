<Window x:Class="HomeOrOffice.ExportKonfig"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HomeOrOffice"
        mc:Ignorable="d"
        Title="ExportKonfig" Height="310" Width="600" ResizeMode="NoResize" x:ClassModifier="internal">
    <Window.Resources>

        <Style x:Key="DefaultSubmit" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="AliceBlue"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="SeaGreen" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#FF01b090"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <ControlTemplate x:Key="tbDefaultSubmit" TargetType="{x:Type ButtonBase}">
            <Border x:Name="border" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                <ContentPresenter x:Name="contentPresenter" ContentTemplate="{TemplateBinding ContentTemplate}" Content="{TemplateBinding Content}" ContentStringFormat="{TemplateBinding ContentStringFormat}" Focusable="False" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="Button.IsDefaulted" Value="True">
                    <Setter Property="BorderBrush" TargetName="border" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
                </Trigger>
                <Trigger Property="ToggleButton.IsChecked" Value="True">
                    <Setter Property="Background" TargetName="border" Value="#FFBCDDEE"/>
                    <Setter Property="BorderBrush" TargetName="border" Value="#FF245A83"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" TargetName="border" Value="#FFF4F4F4"/>
                    <Setter Property="BorderBrush" TargetName="border" Value="#FFADB2B5"/>
                    <Setter Property="Foreground" Value="#FF838383"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <Style x:Key="DefaultCancel" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="IndianRed"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="DarkRed" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#FF610000"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <ControlTemplate x:Key="tbDefaultCancel" TargetType="{x:Type ButtonBase}">
            <Border x:Name="border" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                <ContentPresenter x:Name="contentPresenter" ContentTemplate="{TemplateBinding ContentTemplate}" Content="{TemplateBinding Content}" ContentStringFormat="{TemplateBinding ContentStringFormat}" Focusable="False" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="Button.IsDefaulted" Value="True">
                    <Setter Property="BorderBrush" TargetName="border" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
                </Trigger>
                <Trigger Property="ToggleButton.IsChecked" Value="True">
                    <Setter Property="Background" TargetName="border" Value="#FFBCDDEE"/>
                    <Setter Property="BorderBrush" TargetName="border" Value="#FF245A83"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" TargetName="border" Value="#FFF4F4F4"/>
                    <Setter Property="BorderBrush" TargetName="border" Value="#FFADB2B5"/>
                    <Setter Property="Foreground" Value="#FF838383"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>


    </Window.Resources>
    <Window.TaskbarItemInfo>
        <TaskbarItemInfo/>
    </Window.TaskbarItemInfo>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="0*"/>
        </Grid.ColumnDefinitions>
        <ListView x:Name="lbYears" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" Width="190" MaxWidth="190" SelectionMode="Single" SelectionChanged="LbYears_SelectionChanged" Height="252" MaxHeight="254">
            <ListView.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FFEAF5FF" Offset="1"/>
                    <GradientStop Color="White" Offset="0.235"/>
                </LinearGradientBrush>
            </ListView.Background>
        </ListView>
        <Label x:Name="lbNumbersHome" Content="Number of days you worked at home:" HorizontalAlignment="Left" Margin="213,33,0,0" VerticalAlignment="Top" Width="253" Height="26"/>
        <TextBox x:Name="tbNmbHome" HorizontalAlignment="Left" Height="26" Margin="471,0,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="58" Background="#FFDADADA" HorizontalContentAlignment="Center" IsReadOnly="True" RenderTransformOrigin="1.405,0.517" VerticalContentAlignment="Center">
            <TextBox.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform/>
                    <RotateTransform/>
                    <TranslateTransform Y="30"/>
                </TransformGroup>
            </TextBox.RenderTransform>
        </TextBox>
        <Label x:Name="lbNumbersOffice" Content="Number of days you worked in the office:" HorizontalAlignment="Left" Margin="213,31,0,0" VerticalAlignment="Top" Width="253" Height="26" RenderTransformOrigin="0.5,0.5">
            <Label.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform/>
                    <RotateTransform/>
                    <TranslateTransform Y="40"/>
                </TransformGroup>
            </Label.RenderTransform>
        </Label>
        <TextBox x:Name="tbNmbOffice" HorizontalAlignment="Left" Height="26" Margin="471,31,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="58" Background="#FFDADADA" HorizontalContentAlignment="Center" IsReadOnly="True" RenderTransformOrigin="1.405,0.517" VerticalContentAlignment="Center">
            <TextBox.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform/>
                    <RotateTransform/>
                    <TranslateTransform Y="40"/>
                </TransformGroup>
            </TextBox.RenderTransform>
        </TextBox>
        <Button Template="{DynamicResource tbDefaultSubmit}" Style="{DynamicResource DefaultSubmit}" x:Name="btnSubmitExport" Content="export Excle file" HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="140" Margin="0,0,9.6,9.8" RenderTransformOrigin="0.5,0.5" Height="47" Click="BtnSubmitExport_Click" />
        <Label x:Name="lbNumbersNoEntry" Content="Number of days with no entry:" HorizontalAlignment="Left" Margin="213,111,0,0" VerticalAlignment="Top" Width="253" Height="26" RenderTransformOrigin="0.5,0.5">
            <Label.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform/>
                    <RotateTransform/>
                    <TranslateTransform Y="40"/>
                </TransformGroup>
            </Label.RenderTransform>
        </Label>
        <TextBox x:Name="tbNmbDayOff" HorizontalAlignment="Left" Height="26" Margin="471,111,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="58" Background="#FFDADADA" HorizontalContentAlignment="Center" IsReadOnly="True" RenderTransformOrigin="1.405,0.517" VerticalContentAlignment="Center">
            <TextBox.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform/>
                    <RotateTransform/>
                    <TranslateTransform Y="40"/>
                </TransformGroup>
            </TextBox.RenderTransform>
        </TextBox>
        <Button Template="{DynamicResource tbDefaultCancel}" Style="{DynamicResource DefaultCancel}" x:Name="btnDeleteYear" Content="Delete Year" VerticalAlignment="Bottom" Width="100" RenderTransformOrigin="-0.509,1.149" Click="BtnDeleteYear_Click" Cursor="Hand" HorizontalAlignment="Right" Margin="0,0,280.6,9.8" />
        <TextBox x:Name="tbNmbTrip" HorizontalAlignment="Left" Height="26" Margin="471,71,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="58" Background="#FFDADADA" HorizontalContentAlignment="Center" IsReadOnly="True" RenderTransformOrigin="1.405,0.517" VerticalContentAlignment="Center">
            <TextBox.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform/>
                    <RotateTransform/>
                    <TranslateTransform Y="40"/>
                </TransformGroup>
            </TextBox.RenderTransform>
        </TextBox>
        <Label x:Name="lbNumbersTrip" Content="Number of days you were on a Business Trip:" HorizontalAlignment="Left" Margin="213,71,0,0" VerticalAlignment="Top" Width="253" Height="26" RenderTransformOrigin="0.5,0.5">
            <Label.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform/>
                    <RotateTransform/>
                    <TranslateTransform Y="40"/>
                </TransformGroup>
            </Label.RenderTransform>
        </Label>
    </Grid>
</Window>
